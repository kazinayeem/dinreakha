# Add project specific R8 rules here.
# AGP will combine all keep rule files in src/main/keepRules to pass to R8
#
# For more details, see
#   https://d.android.com/r/tools/r8/keep-rules

# If your project uses WebView with JS, uncomment the following
# and specify the fully qualified class name to the JavaScript interface
# class:
#-keepclassmembers class fqcn.of.javascript.interface.for.webview {
#   public *;
#}
# Room: entities/DAOs are generated at compile time; keep the generated database implementation.
-keep class * extends androidx.room.RoomDatabase { <init>(); }
# Enums are restored from their names (backup import, settings): keep their names.
-keepclassmembers enum com.example.tracker.** { *; }
# Receivers/services are referenced from the manifest (kept automatically), and the accessibility service by name.
-keep class com.example.tracker.blocker.** { *; }

# Glance widget button actions are instantiated by class name
-keep class * implements androidx.glance.appwidget.action.ActionCallback { <init>(); }

# WorkManager (used by Glance to redraw widgets) creates these by reflection; R8 full mode
# otherwise strips the constructors and every widget update fails with InstantiationException.
-keep class * extends androidx.work.InputMerger { public <init>(); }
-keep class * extends androidx.work.ListenableWorker { public <init>(android.content.Context, androidx.work.WorkerParameters); }
